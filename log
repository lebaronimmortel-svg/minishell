#include "libft.h"

static int	check_space(const char *str, int i)
{
	while (str[i] == '\t'
		|| str[i] == '\n'
		|| str[i] == '\v'
		|| str[i] == '\f'
		|| str[i] == '\r'
		|| str[i] == ' ')
		return (1);
	return (0);
}

static int	calcul(const char *str, int i, int signe, int result)
{
	while (str[i])
	{
		if (str[i] >= '0' && str[i] <= '9')
			result = result * 10 + str[i] - '0';
		else
			return (result * signe);
		i++;
	}
	return (result * signe);
}

int	ft_atoi(const char *nptr)
{
	int	result;
	int	i;
	int	signe;

	i = 0;
	result = 0;
	signe = 1;
	while (check_space(nptr, i))
		i++;
	if (nptr[i] == '+' || nptr[i] == '-')
	{
		if (nptr[i] == '-')
			signe = -1;
		i++;
	}
	result = calcul(nptr, i, signe, result);
	return (result);
}
