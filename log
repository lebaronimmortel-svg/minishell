char	*ft_strchr(const char *s, int c)
{
	int	i;

	if (s[0] == (char)c)
		return ((char *)&s[0]);
	i = 1;
	while (s[i - 1])
	{
		if (s[i] == (char)c)
			return ((char *)&s[i]);
		i++;
	}
	return (NULL);
}
