# Flag pour l'execution Valgrind :

	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --track-fds=yes --trace-children=yes --suppressions=valgrind.supp ./minishell

# Fichier valgrind.supp :

	{
	   readline_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libreadline.so*
	   ...
	}

	{
	   libtinfo_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libtinfo.so*
	   ...
	}

# Parsing :

-BASH : '$PWD' -> '/home/lukrodri/Documents/MAIN/Cercle 3/MINISHELL'
-MINISHELL : '$PWD' -> '$PWD'

-BASH : printf "$USER$USER'' = ' $L ANG '" '' -> lukrodrilukrodri'' = '  ANG '
-MINISHELL :
		printf "$USER$USER'' = ' $L ANG '" '' -> lukrodrilukrodri''printf: warning: ignoring excess arguments, starting with ‘=’

-BASH : < Makefile | printf 'You see me?' -> You see me?
-MINISHELL : < Makefile | printf 'You see me?' -> nothing

-BASH : echo  Ichi Ni San Yon Go | cat -e -> Ichi Ni San Yon Go$
-MINISHELL : echo  Ichi Ni San Yon Go | cat -e -> Ichi Ni San Yon Go

-BASH : env | grep USER | md5sum -> 54e99a849d3e47596d69856d61cca7e3  -
-MINISHELL : env | grep USER | md5sum -> whole env and no end of prompt

# Built_in : 

-ECHO :
-BASH: echo $$$USER -> 2050647lukrodri
-MINISHELL : echo $$$USER -> $

-ECHO :
-BASH : echo -nnnnnnnnnnnnnn -nns -n test -> -nns -n test
-MINISHELL : echo -nnnnnnnnnnnnnn -nns -n test -> test

- Rajouter les exit_code aux built_in (comme fait pour pwd)

- command 'cd' toute seule ne fait rien, devrait ramener au root (vrai behavior)
	(a voir)

# Signaux :

- sleep 10 | echo a		puis Ctrl-C pendant le sleep renvoie exit status (130) au lieu de 0
						duplique le '<' input de minishell
						n'affiche pas a
- Ctrl-C devrait exit heredoc
- Ctrl-D devrait afficher heredoc :warning: here-document at line 2 delimited by end-of-file (wanted `EOF')

# Exit STATUS :

- check Segfault pour tous les malloc -> exit status (139)
- exit : 128: Invalid argument to exit.
-Ctrl-C : 130: Script terminated by Control-C.

-BUILTIN : exit status(2): Misuse of shell builtins

