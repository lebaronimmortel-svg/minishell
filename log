{
	int	i;

	i = 0;
	while (lex[i].type)
	{
		free(lex[i].value);
		i++;
	}
	free(lex[i].value);
	free(lex);
}

static void	execute_prompt(char **envp, char **split, t_token *lex,
	t_data *data)
{
	print_lexer(lex);
	if (parser(lex))
	{
		printf("\n✅ OK\n\n\n");
		split = print_order(lex);
		free_lexer(lex);
		print_icon(2);
