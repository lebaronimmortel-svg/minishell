#include "libft.h"

char	*ft_strnstr(const char *big, const char *little, size_t len)
{
	size_t		i;
	int			check;
	int			len_to_find;

	len_to_find = 0;
	if (little[0] == 0)
		return ((char *)big);
	while (little[len_to_find])
		len_to_find++;
	i = 0;
	check = 0;
	while (big[i] && i < len)
	{
		if (big[i] == little[check])
			check++;
		else
		{
			i = i - check;
			check = 0;
		}
		if (check == len_to_find)
			return ((char *)&big[i - len_to_find + 1]);
		i++;
	}
	return (NULL);
}
