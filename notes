# Flag pour l'execution Valgrind :

	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --track-fds=yes --trace-children=yes --suppressions=valgrind.supp ./minishell

# Fichier valgrind.supp :

	{
	   readline_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libreadline.so*
	   ...
	}

	{
	   libtinfo_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libtinfo.so*
	   ...
	}





# Parsing :

-BASH : printf "$USER$USER'' = ' $L ANG '" '' -> lukrodrilukrodri'' = '  ANG '
-MINISHELL :
		printf "$USER$USER'' = ' $L ANG '" '' -> lukrodrilukrodri''printf: warning: ignoring excess arguments, starting with ‘=’
-BASH : < Makefile | printf 'You see me?' -> You see me?
-MINISHELL : < Makefile | printf 'You see me?' -> Youprintf: warning: ignoring excess arguments, starting with ‘see’

env -i :
-BASH : clear -> TERM environment variable not set.
-MINISHELL : clear -> clear: command not found

HEREDOC << EOF:
-BASH : '$PWD' -> '/home/lukrodri/Documents/MAIN/Cercle 3/MINISHELL'
