# Flag pour l'execution Valgrind :

	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes --track-fds=yes --trace-children=yes --suppressions=valgrind.supp ./minishell

# Fichier valgrind.supp :

	{
	   readline_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libreadline.so*
	   ...
	}

	{
	   libtinfo_leak
	   Memcheck:Leak
	   match-leak-kinds: reachable
	   ...
	   obj:*/libtinfo.so*
	   ...
	}

# Parsing :

COMMAND : ..
-BASH : ..: command not found
-MINISHELL : ..: Permission denied

COMMAND : > file
-BASH : create file
-MINISHELL : nothing

-BASH :	touch test
		chmod 000 test
		./test 
result : ./ok: Permission denied
-MINISHELL :	touch test
				chmod 000 test
				./test 
result : ./ok: No such file or directory


-BASH : touch test | chmod 000 test | ./test
result :	./test: No such file or directory
			chmod: cannot access 'test': No such file or directory
-MINISHELL :



