#include "../../header/header.h"

int	exists(char *str, t_data *data, int *i)
{
	int	len;

	len = 0;
	while (str[len] != '=')
		len++;
	while (data->env[*i])
	{
		if (!ft_strncmp(str, data->env[*i], len) && data->env[*i][len] == '=')
			return (1);
		(*i)++;
	}
	*i = 0;
	while (data->env_bis[*i])
	{
		if (!ft_strncmp(str, data->env_bis[*i], len)
			&& data->env_bis[*i][len] == '\0')
			return (2);
		(*i)++;
	}
	return (0);
}

static void	sort_split(char **split)
{
	int		i;
	char	*tmp;

	if (!split || !(*split))
		return ;
	i = 1;
	while (split[i])
	{
		if (ft_strncmp(split[i - 1], split[i], ft_strlen(split[i] + 1)) > 0)
		{
			tmp = split[i];
			split[i] = split[i - 1];
			split[i - 1] = tmp;
			i = 1;
		}
		else
			i++;
	}
}

void	export_single(t_data *data)
{
	sort_split(data->env_bis);
	print_split(data->env_bis);
}

void	ft_export(char *input, t_data *data)
{
	char	**split;
	int		len;
	int		i;

	split = ft_split(input, ' ');
	len = my_memlen(split);
	if (len < 2)
	{
		free_split(split, 0);
		return ;
	}
	i = 1;
	while (split[i])
		add_var(split[i++], data);
	free_split(split, 0);
	return ;
}
