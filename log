		free_split(split, 0);
		printf("\n");
	}
	else
		printf("\n❌ NOK\n\n");
}

void	main_loop(char **envp, char **split, t_token *lex, t_data *data)
{
	char	*str;

	while (1)
	{
		str = readline("\n$> ");
		if (str == NULL)
			exit_cleanly(0, data, split);
		add_history(str);
		lex = lexer(str, data);
		free(str);
		if (lex)
			execute_prompt(envp, split, lex, data);
	}
}
