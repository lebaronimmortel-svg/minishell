static char	**print_order(t_token *lexer)
{
	int		i;
	char	**split;

	i = 0;
	while (lexer[i].type)
		i++;
	split = ft_calloc(2 * (i + 1), sizeof(char *));
	if (!split)
		return (NULL);
	split[0] = ft_strdup("");
	print_icon(1);
	printf("\nExecute :\n\n");
	loop(lexer, split);
	printf("\n\n");
	return (split);
