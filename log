#include "libft.h"

char	*ft_strrchr(const char *s, int c)
{
	int	i;
	int	index;

	index = -1;
	if (s[0] == (char)c)
		index = 0;
	i = 1;
	while (s[i - 1])
	{
		if (s[i] == (char)c)
			index = i;
		i++;
	}
	if (index == -1)
		return (NULL);
	return ((char *)&s[index]);
}
